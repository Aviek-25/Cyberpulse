# CyberPulse local web server
PORT=3000

# WAZUH SELF-HOSTED ON A CLOUD SERVER (recommended connector)
# Use the private HTTPS URL reachable from the machine running CyberPulse.
# For example: https://10.0.0.12:9200 or https://wazuh-indexer.internal:9200
# Do NOT expose port 9200 to the public internet. Prefer a private network/VPN/firewall allowlist.
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEX_PATTERN=wazuh-alerts-*

# Use a TLS certificate trusted by the machine running CyberPulse. Do not disable verification in production.

# OPTIONAL generic provider connector (used only when WAZUH_INDEXER_URL is blank)
SECURITY_API_URL=
SECURITY_API_KEY=
SECURITY_API_AUTH_HEADER=Authorization
SECURITY_API_AUTH_SCHEME=Bearer
SECURITY_API_KEY_PREFIX=
SECURITY_API_EVENTS_PATH=

# Polling and request limits
SECURITY_API_TIMEOUT_MS=8000
SECURITY_API_CACHE_MS=8000
